<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeColor="@color/card_stroke"
    app:strokeWidth="@dimen/card_stroke_width"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_md"
        android:paddingEnd="@dimen/spacing_md"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- Top Content Row: Checkbox + Title/Description + Priority -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <!-- Modern Circular Checkbox -->
            <CheckBox
                android:id="@+id/cbCompleted"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="1dp"
                android:layout_marginEnd="12dp"
                android:button="@null"
                android:background="@drawable/selector_custom_checkbox"
                android:contentDescription="@string/complete" />

            <!-- Title & Description Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_subheading"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="Design System Review &amp; UI Polish" />

                <!-- Description (optional) -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="@dimen/text_body"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:visibility="gone"
                    tools:text="Finalize typography, spacing scale, and responsive card components for release."
                    tools:visibility="visible" />

            </LinearLayout>

            <!-- Priority Badge -->
            <TextView
                android:id="@+id/tvPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:paddingStart="@dimen/priority_badge_padding_h"
                android:paddingEnd="@dimen/priority_badge_padding_h"
                android:paddingTop="@dimen/priority_badge_padding_v"
                android:paddingBottom="@dimen/priority_badge_padding_v"
                tools:text="HIGH"
                tools:textColor="@color/priority_high"
                tools:background="@drawable/priority_badge_background" />

        </LinearLayout>

        <!-- Divider line for visual polish -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginStart="38dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp" />

        <!-- Bottom Metadata Row: Date / Overdue badge / Edit & Delete actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="38dp"
            android:gravity="center_vertical">

            <!-- Due Date & Time Badge -->
            <TextView
                android:id="@+id/tvDueDateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_caption"
                android:textColor="@color/text_secondary"
                android:drawableStart="@drawable/ic_calendar"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:visibility="gone"
                app:drawableTint="@color/text_secondary"
                tools:text="Oct 15, 2:30 PM"
                tools:visibility="visible" />

            <!-- Overdue Badge -->
            <TextView
                android:id="@+id/tvOverdueBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/overdue"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/priority_high"
                android:background="@drawable/bg_badge_overdue"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Actions Row -->
            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/edit"
                android:layout_marginEnd="4dp"
                app:tint="@color/text_secondary" />

            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete_task"
                app:tint="@color/text_muted" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
